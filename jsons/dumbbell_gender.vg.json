{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {"step": 40},
  "data": {
    "url": "data/gender_gap.json"
  },
  "encoding": {
    "y": {"field": "Age Group", "type": "nominal", "axis": {"title": "Age Group", "labelPadding": 10}}
  },
  "layer": [
    {
      "mark": {"type": "line", "color": "#cbd5e1", "strokeWidth": 3},
      "encoding": {
        "detail": {"field": "Age Group", "type": "nominal"},
        "x": {"field": "Participation", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "circle", "size": 150, "opacity": 1},
      "encoding": {
        "x": {
          "field": "Participation",
          "type": "quantitative",
          "scale": {"domain": [0, 100]},
          "axis": {"title": "Participation Rate (%)"}
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {"range": ["#08519c", "#9ecae1"]}
        },
        "tooltip": [
          {"field": "Gender", "type": "nominal"},
          {"field": "Participation", "type": "quantitative", "title": "Rate (%)"}
        ]
      }
    }
  ]
}