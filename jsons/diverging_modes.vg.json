{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/study_modes.json"
  },
  "transform": [
    {
      "calculate": "datum.Type == 'Part-time' ? -datum.Students : datum.Students",
      "as": "SignedStudents"
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": ["NSW", "Vic", "Qld", "WA", "SA", "ACT", "Tas", "NT"],
      "axis": {"grid": false, "labelFontWeight": "bold"}
    },
    "x": {
      "field": "SignedStudents",
      "type": "quantitative",
      "title": "Number of Students",
      "axis": {
        "labelExpr": "abs(datum.value) / 1000 + 'k'",
        "grid": true,
        "gridOpacity": 0.4
      }
    },
    "color": {
          "field": "Type",
          "type": "nominal",
          "scale": {"range": ["#9ecae1", "#08519c"]},
          "legend": {
            "title": "Study Mode",
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 14,
            "labelFontSize": 13,
            "symbolSize": 200,
            "padding": 10
          }
        },
    "tooltip": [
      {"field": "State", "type": "nominal"},
      {"field": "Type", "type": "nominal"},
      {"field": "Students", "type": "quantitative", "format": ",", "title": "Total Students"}
    ]
  }
}