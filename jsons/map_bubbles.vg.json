{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/state_enrollments.json"
      },
      "mark": {"type": "circle", "color": "#08519c", "opacity": 0.7},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "total_students",
          "type": "quantitative",
          "scale": {
            "domain": [5000, 350000],
            "range": [30, 450]
          },
          "legend": {
            "title": "Total Students",
            "orient": "bottom-left",
            "direction": "horizontal",
            "values": [50000, 150000, 300000],
            "format": "~s",
            "titleFontSize": 10,
            "labelFontSize": 9,
            "symbolSize": 120,
            "columnPadding": 8
          }
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "total_students", "type": "quantitative", "title": "Total Enrolled", "format": ","}
        ]
      }
    }
  ]
}