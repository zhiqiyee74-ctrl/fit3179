{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "values": [
          {"state": "WA", "lon": 122.5, "lat": -26.0},
          {"state": "NT", "lon": 133.5, "lat": -21.0},
          {"state": "SA", "lon": 136.0, "lat": -30.0},
          {"state": "QLD", "lon": 144.0, "lat": -22.5},
          {"state": "NSW", "lon": 146.5, "lat": -32.5},
          {"state": "VIC", "lon": 144.5, "lat": -36.5},
          {"state": "TAS", "lon": 146.5, "lat": -42.0}
        ]
      },
      "mark": {
        "type": "text",
        "color": "#333333",
        "fontSize": 11,
        "fontWeight": "bold",
        "opacity": 0.8
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "data/state_enrollments.json"
      },
      "mark": {
        "type": "circle",
        "color": "#4a7eab",
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "total_students",
          "type": "quantitative",
          "scale": {"range": [50, 800]},
          "legend": {
            "title": "Total Students",
            "orient": "bottom",
            "direction": "horizontal",
            "padding": 15
          }
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "total_students", "type": "quantitative", "format": ",", "title": "Total Students"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"}
  }
}