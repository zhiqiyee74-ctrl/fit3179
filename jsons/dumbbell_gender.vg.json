{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Gender Gap in Tertiary Study Participation",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/gender_gap.json"
  },
  "encoding": {
    "y": {
      "field": "Age",
      "type": "nominal",
      "axis": {"title": "Age Group", "grid": true, "gridOpacity": 0.4}
    },
    "x": {
      "field": "Proportion",
      "type": "quantitative",
      "axis": {"title": "Participation Rate (%)"}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "color": "#cbd5e1", "size": 3},
      "encoding": {
        "detail": {"field": "Age"}
      }
    },
    {
      "mark": {"type": "point", "size": 150, "filled": true, "opacity": 1},
      "encoding": {
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {"range": ["#08519c", "#9ecae1"]},
          "legend": {"title": "Gender", "orient": "bottom-right"}
        },
        "tooltip": [
          {"field": "Age", "type": "nominal"},
          {"field": "Gender", "type": "nominal"},
          {"field": "Proportion", "type": "quantitative", "title": "Participation (%)"}
        ]
      }
    }
  ]
}