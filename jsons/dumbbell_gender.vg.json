{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/gender_gap.json"
  },
  "layer": [
    {
      "mark": {"type": "line", "color": "#cbd5e1", "strokeWidth": 3},
      "encoding": {
        "y": {
          "field": "Age", 
          "type": "nominal", 
          "axis": {"title": "Age Group", "labelPadding": 10}
        },
        "x": {
          "field": "Proportion", 
          "type": "quantitative", 
          "scale": {"domain": [0, 50]}
        },
        "detail": {"field": "Age", "type": "nominal"}
      }
    },
    {
      "mark": {"type": "circle", "size": 150, "opacity": 1},
      "encoding": {
        "y": {"field": "Age", "type": "nominal"},
        "x": {
          "field": "Proportion",
          "type": "quantitative",
          "axis": {"title": "Participation Rate (%)"},
          "scale": {"domain": [0, 50]}
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {"range": ["#08519c", "#9ecae1"]},
          "legend": {
            "title": "Gender",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "Age", "type": "nominal", "title": "Age Group"},
          {"field": "Gender", "type": "nominal"},
          {"field": "Proportion", "type": "quantitative", "title": "Rate (%)"}
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {"op": "min", "field": "Proportion", "as": "min_prop"},
            {"op": "max", "field": "Proportion", "as": "max_prop"}
          ],
          "groupby": ["Age"]
        },
        {
          "calculate": "(datum.max_prop + datum.min_prop) / 2",
          "as": "midpoint"
        },
        {
          "calculate": "format(datum.max_prop - datum.min_prop, '.1f') + '%'",
          "as": "gap_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -15,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#08519c"
      },
      "encoding": {
        "y": {"field": "Age", "type": "nominal"},
        "x": {
          "field": "midpoint", 
          "type": "quantitative", 
          "scale": {"domain": [0, 50]}
        },
        "text": {"field": "gap_label", "type": "nominal"}
      }
    }
  ]
}