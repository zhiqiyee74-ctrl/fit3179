{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "data": {"url": "data/fields_radial.json"},
  "mark": {"type": "bar", "cornerRadiusEnd": 4},
  "encoding": {
    "y": {
      "field": "Field",
      "type": "nominal",
      "sort": {"field": "Students", "order": "descending"},
      "title": null,
      "axis": {"labelLimit": 150}
    },
    "x": {
      "field": "Students",
      "type": "quantitative",
      "title": "Total Enrollments"
    },
    "color": {
      "field": "Field",
      "type": "nominal",
      "scale": {
        "range": ["#1f77b4", "#ff7f0e", "#9467bd", "#e377c2", "#17becf", "#7f7f7f", "#e7ba52", "#2ca02c", "#d62728", "#8c564b"]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "Field", "type": "nominal", "title": "Field of Study"},
      {"field": "Students", "type": "quantitative", "format": ",", "title": "Total Students"}
    ]
  }
}