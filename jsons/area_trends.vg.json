{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/foe_trends.json"
  },
  "params": [
    {"name": "Edu", "value": true, "bind": {"input": "checkbox", "name": "Education "}},
    {"name": "Eng", "value": true, "bind": {"input": "checkbox", "name": "Engineering "}},
    {"name": "Hea", "value": true, "bind": {"input": "checkbox", "name": "Health "}},
    {"name": "IT", "value": true, "bind": {"input": "checkbox", "name": "IT "}},
    {"name": "Com", "value": true, "bind": {"input": "checkbox", "name": "Commerce "}},
    {"name": "Sci", "value": true, "bind": {"input": "checkbox", "name": "Science "}},
    {"name": "Soc", "value": true, "bind": {"input": "checkbox", "name": "Society "}}
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": true
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "axis": {"labelAngle": 0, "grid": false}
        },
        "y": {
          "field": "Proportion", 
          "type": "quantitative",
          "stack": null,
          "scale": {"zero": false},
          "axis": {
            "title": "Participation Share (%)"
          }
        },
        "color": {
          "field": "Field",
          "type": "nominal",
          "legend": null,
          "scale": {
            "range": ["#1f77b4", "#ff7f0e", "#9467bd", "#e377c2", "#17becf", "#7f7f7f", "#e7ba52"]
          }
        },
        "opacity": {
          "condition": {
            "test": "(!Edu && !Eng && !Hea && !IT && !Com && !Sci && !Soc) || (Edu && datum.Field == 'Education') || (Eng && datum.Field == 'Engineering') || (Hea && datum.Field == 'Health') || (IT && datum.Field == 'Information technology') || (Com && datum.Field == 'Management/Commerce') || (Sci && datum.Field == 'Science') || (Soc && datum.Field == 'Society/Culture')",
            "value": 0.6
          },
          "value": 0.05
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 50
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Proportion",
          "type": "quantitative",
          "stack": null,
          "scale": {"zero": false}
        },
        "color": {
          "field": "Field",
          "type": "nominal",
          "legend": null,
          "scale": {
            "range": ["#1f77b4", "#ff7f0e", "#9467bd", "#e377c2", "#17becf", "#7f7f7f", "#e7ba52"]
          }
        },
        "opacity": {
          "condition": {
            "test": "(!Edu && !Eng && !Hea && !IT && !Com && !Sci && !Soc) || (Edu && datum.Field == 'Education') || (Eng && datum.Field == 'Engineering') || (Hea && datum.Field == 'Health') || (IT && datum.Field == 'Information technology') || (Com && datum.Field == 'Management/Commerce') || (Sci && datum.Field == 'Science') || (Soc && datum.Field == 'Society/Culture')",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {"field": "Field", "type": "nominal", "title": "Field"},
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Proportion", "type": "quantitative", "format": ".1f", "title": "Share (%)"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule", 
        "color": "#e6550d", 
        "strokeDash": [4, 4], 
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"datum": 2020, "type": "ordinal"}
      }
    },
    {
      "mark": {
        "type": "text", 
        "align": "right", 
        "dx": -8, 
        "dy": 15,
        "fontSize": 11, 
        "fontStyle": "italic", 
        "color": "#e6550d",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"datum": 2020, "type": "ordinal"},
        "y": {"datum": 23.5}, 
        "text": {"value": ["Pandemic surge begins (2020)"]}
      }
    }
  ]
}