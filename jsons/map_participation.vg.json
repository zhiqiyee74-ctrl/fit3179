{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Study Participation Rate by State/Territory (%)",
  "width": 600,
  "height": 400,
  "projection": {"type": "mercator"},
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/state_participation.json"
        },
        "key": "state",
        "fields": ["participation_rate"]
      }
    },
    {
      "calculate": "datum.participation_rate || 0",
      "as": "Participation Rate"
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1},
  "encoding": {
    "color": {
      "field": "Participation Rate",
      "type": "quantitative",
      "scale": {
        "scheme": "blues"
      },
      "legend": {
        "title": "Participation (%)",
        "orient": "bottom-right"
      }
    },
    "tooltip": [
      {"field": "properties.STATE_NAME", "type": "nominal", "title": "State"},
      {"field": "Participation Rate", "type": "quantitative", "title": "Participation Rate (%)"}
    ]
  }
}