{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Domestic Student Course Enrollment by Age",
  "width": "container",
  "height": 400,
  "data": {
    "url": "jsons/age_vs_level.json"
  },
  "encoding": {
    "y": {
      "field": "Age",
      "type": "nominal",
      "title": "Student Age",
      "sort": ["17", "18", "19", "20", "21", "22", "23", "24", "25-29", "30-39"]
    },
    "x": {
      "field": "Level",
      "type": "nominal",
      "title": "Broad Course Level",
      "sort": ["Bachelor", "Postgraduate", "Sub-Bachelor", "Enabling/Other"]
    }
  },
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "color": {
          "field": "Students",
          "type": "quantitative",
          "scale": {"scheme": "blues"},
          "legend": {
            "title": "Number of Students",
            "orient": "right",
            "format": "~s"
          }
        },
        "tooltip": [
          {"field": "Age", "type": "nominal"},
          {"field": "Level", "type": "nominal"},
          {"field": "Students", "type": "quantitative", "format": ","}
        ]
      }
    },
    {
      "mark": "text",
      "encoding": {
        "text": {
          "field": "Students",
          "type": "quantitative",
          "format": "~s"
        },
        "color": {
          "condition": {"test": "datum['Students'] > 40000", "value": "white"},
          "value": "#1e293b"
        }
      }
    }
  ]
}