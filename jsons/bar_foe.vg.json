{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {"url": "data/fields_radial.json"},
  "layer": [
    {
      "mark": {"type": "rule", "size": 3, "color": "#cbd5e1"},
      "encoding": {
        "y": {"field": "Field", "type": "nominal", "sort": {"field": "Students", "order": "descending"}, "axis": {"title": null, "labelLimit": 150}},
        "x": {"field": "Students", "type": "quantitative", "axis": {"title": "Total Enrollments"}}
      }
    },
    {
      "mark": {"type": "circle", "size": 250, "opacity": 1},
      "encoding": {
        "y": {"field": "Field", "type": "nominal", "sort": {"field": "Students", "order": "descending"}},
        "x": {"field": "Students", "type": "quantitative"},
        "color": {
          "field": "Field",
          "type": "nominal",
          "scale": {"range": ["#08519c", "#3182bd", "#6baed6", "#9ecae1", "#c6dbef", "#e6550d", "#fd8d3c", "#fdae6b", "#fdd0a2", "#31a354"]},
          "legend": null
        },
        "tooltip": [
          {"field": "Field", "type": "nominal", "title": "Field of Study"},
          {"field": "Students", "type": "quantitative", "format": ",", "title": "Total Students"}
        ]
      }
    },
    {
      "mark": {"type": "rule", "color": "#e6550d", "strokeDash": [4, 4], "size": 1.5},
      "encoding": {
        "x": {"aggregate": "mean", "field": "Students", "type": "quantitative"}
      }
    }
  ]
}