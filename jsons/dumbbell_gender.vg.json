{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {"step": 40},
  "data": {
    "url": "data/gender_gap.json"
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#cbd5e1", "size": 2},
      "encoding": {
        "y": {"field": "Age Group", "type": "nominal"},
        "x": {"aggregate": "min", "field": "Participation", "type": "quantitative"},
        "x2": {"aggregate": "max", "field": "Participation"}
      }
    },
    {
      "mark": {"type": "circle", "size": 150, "opacity": 1},
      "encoding": {
        "y": {
          "field": "Age Group", 
          "type": "nominal", 
          "axis": {"title": "Age Group", "labelPadding": 10}
        },
        "x": {
          "field": "Participation",
          "type": "quantitative",
          "scale": {"domain": [0, 50]},
          "axis": {"title": "Participation Rate (%)"}
        },
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {"range": ["#08519c", "#9ecae1"]}
        },
        "tooltip": [
          {"field": "Gender", "type": "nominal"},
          {"field": "Participation", "type": "quantitative", "title": "Rate (%)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 15, "dy": -10, "fontSize": 11, "fontStyle": "italic", "color": "#08519c", "fontWeight": "bold"},
      "encoding": {
        "y": {"datum": "20-24"},
        "x": {"datum": 21},
        "text": {"value": ["Largest gender participation gap"]}
      }
    }
  ]
}