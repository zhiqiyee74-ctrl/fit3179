{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/gender_gap.json"
  },
  "encoding": {
    "y": {
      "field": "Age",
      "type": "nominal",
      "axis": {"title": "Age Group", "grid": true, "gridOpacity": 0.4}
    },
    "height": {"step": 40}, 
    "encoding": {
      "x": {
        "field": "Participation",
        "type": "quantitative",
        "scale": {"domain": [0, 48]},
        "axis": {"title": "Participation Rate (%)"}
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "color": "#cbd5e1", "size": 3},
      "encoding": {
        "detail": {"field": "Age"}
      }
      
    },
    {
      "mark": {"type": "point", "size": 150, "filled": true, "opacity": 1},
      "encoding": {
        "color": {
          "field": "Gender",
          "type": "nominal",
          "scale": {"range": ["#08519c", "#9ecae1"]},
          "legend": {"title": "Gender", "orient": "bottom-right"}
        },
        "tooltip": [
          {"field": "Age", "type": "nominal"},
          {"field": "Gender", "type": "nominal"},
          {"field": "Proportion", "type": "quantitative", "title": "Participation (%)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "right", "dx": -15, "dy": -10, "fontSize": 11, "fontStyle": "italic", "color": "#08519c", "fontWeight": "bold"},
      "encoding": {
        "y": {"datum": "20-24"},
        "x": {"datum": 45},
        "text": {"value": ["Largest gender participation gap"]}
      }
    }
  ]
}