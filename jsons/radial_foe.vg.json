{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Total Enrollments by Field of Education",
  "width": "container",
  "height": 360,
  "padding": 10,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {
    "url": "data/fields_radial.json"
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 30,
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "tooltip": true
      },
      "encoding": {
        "theta": {
          "field": "Field",
          "type": "nominal",
          "sort": {"field": "Students", "order": "descending"}
        },
        "radius": {
          "field": "Students",
          "type": "quantitative",
          "scale": {"type": "sqrt", "zero": true, "rangeMin": 30}
        },
        "color": {
          "field": "Field",
          "type": "nominal",
          "scale": {
            "domain": [
              "Management & Commerce",
              "Society & Culture",
              "Health",
              "Information Technology",
              "Education",
              "Science",
              "Engineering",
              "Creative Arts",
              "Architecture & Building",
              "Agriculture & Environment"
            ],
            "range": [
              "#1f77b4",
              "#ff7f0e",
              "#9467bd",
              "#e377c2",
              "#17becf",
              "#7f7f7f",
              "#e7ba52",
              "#2ca02c",
              "#d62728",
              "#8c564b"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "Field", "type": "nominal", "title": "Field of Study"},
          {"field": "Students", "type": "quantitative", "title": "Total Students", "format": ","}
        ]
      }
    }
  ]
}